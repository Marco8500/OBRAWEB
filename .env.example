# Copia este archivo con el nombre ".env" y pega tu clave de Replicate.
# Sin clave, la app funciona igual en modo "Rápido" (gratis, en tu computadora).
REPLICATE_API_TOKEN=

# Modelo de IA abierto que anima cada foto (imagen -> video).
REPLICATE_MODEL=wan-video/wan-2.2-i2v-fast

# Puerto de la web (http://localhost:3000)
PORT=3000

# Contraseña para entrar a la app (recomendado si la subes a internet).
APP_PASSWORD=
